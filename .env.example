# Skopiuj ten plik jako .env i uzupełnij
TELEGRAM_TOKEN=123456789:AAAA-token-od-BotFather
TELEGRAM_CHAT_ID=

# Kryteria (można też zmieniać komendami w bocie)
BUDGET=40000
BUDGET_TOLERANCE=4000
MAX_MILEAGE=180000
ONLY_RLINE=0

# Skrzynia, której szukasz: manual / automat (pusta = obojętnie). Inna skrzynia przychodzi tylko jako 💎 perełka
GEARBOX=manual
# Twoje miasto – bot policzy odległość do auta. MAX_DISTANCE_KM=0 to bez limitu (dalej przychodzą tylko 💎)
HOME_CITY=
MAX_DISTANCE_KM=0
# Auta z zagranicy (AutoScout24): 1 = tak, 0 = nie
IMPORT=1

# Co ile sekund skanować (domyślnie ~4 min)
POLL_INTERVAL=240
DB_PATH=sniper.db
